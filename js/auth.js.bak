// ═══════════════════════════════════════
// AUTHENTIFICATION
// ═══════════════════════════════════════

import {
  signInWithEmailAndPassword,
  signOut,
  onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import { auth, db } from "./firebase.js";

let currentUser = null;
let currentRole = "demandeur";

// Écouter les changements d'authentification
export function initAuth(callback) {
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      currentUser = user;
      // Charger le rôle depuis Firestore
      currentRole = await getUserRole(user.uid);
      callback(user, currentRole);
    } else {
      currentUser = null;
      currentRole = "demandeur";
      callback(null, null);
    }
  });
}

// Connexion
export async function login(email, password) {
  try {
    await signInWithEmailAndPassword(auth, email, password);
    return { success: true };
  } catch (error) {
    let message = "Erreur de connexion";
    switch (error.code) {
      case "auth/user-not-found":
        message = "Aucun compte trouvé avec cet email";
        break;
      case "auth/wrong-password":
      case "auth/invalid-credential":
        message = "Mot de passe incorrect";
        break;
      case "auth/too-many-requests":
        message = "Trop de tentatives. Réessayez dans quelques minutes.";
        break;
      case "auth/invalid-email":
        message = "Format d'email invalide";
        break;
    }
    return { success: false, message };
  }
}

// Déconnexion
export async function logout() {
  await signOut(auth);
}

// Obtenir le rôle d'un user depuis Firestore
async function getUserRole(uid) {
  try {
    const userDoc = await getDoc(doc(db, "users", uid));
    if (userDoc.exists()) {
      const role = userDoc.data().role || "demandeur";
      return role === "lecteur" ? "demandeur" : role;
    }
    return "lecteur";
  } catch (e) {
    console.error("Erreur chargement rôle:", e);
    return "lecteur";
  }
}

// Getters
export function getCurrentUser() { return currentUser; }
export function getCurrentRole() { return currentRole; }
